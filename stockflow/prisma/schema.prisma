generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
  binaryTargets   = ["native"]
}

datasource db {
  provider = "postgresql"
}

model AuditLog {
  id             String       @id @default(uuid())
  userId         String
  action         String
  entityType     String?
  entityId       String?
  details        String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "AuditLog_organizationId_fk")
  User           User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model BillOfMaterials {
  id             String       @id @default(uuid())
  designId       String
  rawMaterialId  String
  quantity       Decimal      @db.Decimal(10, 4)
  unitOfMeasure  String       @default("kg")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  design         Design       @relation(fields: [designId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "BillOfMaterials_organizationId_fk")
  RawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id])

  @@unique([designId, rawMaterialId])
  @@index([organizationId])
}

model Branch {
  id                     String                   @id @default(uuid())
  organizationId         String
  name                   String                   @unique
  location               String?
  code                   String                   @unique
  address                String?
  phone                  String?
  managerId              String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  ChartAccount           ChartAccount[]
  Organization           Organization             @relation(fields: [organizationId], references: [id])
  InventoryFinishedGoods InventoryFinishedGoods[]
  InventoryRawMaterial   InventoryRawMaterial[]
  Invitation             Invitation[]
  MaterialReceipt        MaterialReceipt[]
  Product                Product[]
  ProductReceipt         ProductReceipt[]
  JournalEntry           JournalEntry[]
  StockMovement          StockMovement[]
  User                   User[]

  @@unique([organizationId, code], map: "Branch_org_code_key")
  @@unique([organizationId, name], map: "Branch_org_name_key")
}

model Customer {
  id                   String                @id @default(uuid())
  name                 String
  code                 String                @unique
  contactName          String?
  email                String?
  phone                String?
  address              String?
  taxId                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  organizationId       String
  Organization         Organization          @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "Customer_organizationId_fk")
  CustomerPortalAccess CustomerPortalAccess?
  Payment              Payment[]
  SaleOrder            SaleOrder[]

  @@unique([organizationId, code], map: "Customer_org_code_key")
  @@index([organizationId])
}

model CustomerPortalAccess {
  id             String       @id @default(uuid())
  customerId     String       @unique
  accessCode     String       @unique
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  lastLogin      DateTime?
  organizationId String
  Customer       Customer     @relation(fields: [customerId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "CustomerPortalAccess_organizationId_fk")

  @@index([organizationId])
}

model DemandForecast {
  id               String       @id @default(uuid())
  rawMaterialId    String
  forecastDate     DateTime
  forecastedDemand Decimal      @db.Decimal(10, 4)
  confidenceLevel  Float
  basedOnDays      Int
  createdAt        DateTime     @default(now())
  organizationId   String
  Organization     Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "DemandForecast_organizationId_fk")
  RawMaterial      RawMaterial  @relation(fields: [rawMaterialId], references: [id])

  @@unique([rawMaterialId, forecastDate])
  @@index([organizationId])
}

model Design {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  description      String?
  targetDimensions String?
  targetWeight     Decimal?          @db.Decimal(10, 4)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organizationId   String
  lastSeenAt       DateTime?
  category         String?
  expectedYield    Float?
  specifications   Json?
  billOfMaterials  BillOfMaterials[]
  Organization     Organization      @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "Design_organizationId_fk")
  finishedGoods    FinishedGoods[]
  productionOrders ProductionOrder[]
  stages           Stage[]

  @@unique([organizationId, code], map: "Design_org_code_key")
  @@index([organizationId])
}

model FinishedGoods {
  id                     String                   @id @default(uuid())
  sku                    String                   @unique
  designId               String
  quantity               Int
  kgProduced             Decimal                  @db.Decimal(10, 4)
  barcode                String?                  @unique
  batchNumber            String?
  unitCost               Float?
  createdAt              DateTime                 @default(now())
  organizationId         String
  reservedQuantity       Int                      @default(0)
  design                 Design                   @relation(fields: [designId], references: [id])
  Organization           Organization             @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "FinishedGoods_organizationId_fk")
  InventoryFinishedGoods InventoryFinishedGoods[]
  SaleItem               SaleItem[]

  @@unique([organizationId, barcode], map: "FinishedGoods_org_barcode_key")
  @@unique([organizationId, sku], map: "FinishedGoods_org_sku_key")
  @@index([organizationId])
}

model ImportBatch {
  id             String       @id @default(uuid())
  file_name      String
  file_url       String?
  sheet_type     String
  import_mode    ImportMode   @default(update)
  target_branch  String?
  status         ImportStatus @default(uploaded)
  row_count      Int
  mapping_config Json?
  imported_at    DateTime?
  ok_count       Int?
  skipped_count  Int?
  error_count    Int?
  error_summary  String?
  created_by     String
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  organizationId String
  User           User         @relation(fields: [created_by], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "ImportBatch_organizationId_fk")
  ImportRow      ImportRow[]

  @@index([organizationId])
}

model ImportRow {
  id               String       @id @default(uuid())
  batch_id         String
  row_number       Int
  raw_data         Json
  mapped_data      Json?
  matched_product  String?
  match_confidence Float?
  resolution       String?
  resolved_product String?
  order_number     String?
  customer_name    String?
  qty              Float?
  unit_price       Float?
  notes            String?
  errors           String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  organizationId   String
  ImportBatch      ImportBatch  @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  Organization     Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "ImportRow_organizationId_fk")

  @@index([batch_id])
  @@index([organizationId])
}

model InventoryFinishedGoods {
  id              String        @id @default(uuid())
  branchId        String
  finishedGoodsId String
  availableQty    Int           @default(0)
  reservedQty     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  organizationId  String
  Branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  FinishedGoods   FinishedGoods @relation(fields: [finishedGoodsId], references: [id], onDelete: Cascade)
  Organization    Organization  @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "InventoryFinishedGoods_organizationId_fk")

  @@unique([branchId, finishedGoodsId])
  @@index([organizationId])
}

model InventoryRawMaterial {
  id             String       @id @default(uuid())
  branchId       String
  rawMaterialId  String
  availableKg    Decimal      @default(0) @db.Decimal(10, 4)
  reservedKg     Decimal      @default(0) @db.Decimal(10, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  Branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "InventoryRawMaterial_organizationId_fk")
  RawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@unique([branchId, rawMaterialId])
  @@index([organizationId])
}

model MaterialConsumptionLog {
  id                String          @id @default(uuid())
  productionOrderId String
  rawMaterialId     String
  quantityConsumed  Decimal         @db.Decimal(10, 4)
  consumedAt        DateTime        @default(now())
  stageId           String?
  notes             String?
  organizationId    String
  Organization      Organization    @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "MaterialConsumptionLog_organizationId_fk")
  ProductionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  RawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  Stage             Stage?          @relation(fields: [stageId], references: [id])

  @@index([organizationId])
}

model MaterialReceipt {
  id             String       @id @default(uuid())
  materialId     String
  kgReceived     Decimal      @db.Decimal(10, 4)
  reference      String?
  supplierId     String?
  branchId       String?
  loggedBy       String?
  createdAt      DateTime     @default(now())
  organizationId String
  piecesReceived Int          @default(0)
  Branch         Branch?      @relation(fields: [branchId], references: [id])
  RawMaterial    RawMaterial  @relation(fields: [materialId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "MaterialReceipt_organizationId_fk")
  Supplier       Supplier?    @relation(fields: [supplierId], references: [id])

  @@index([organizationId])
}

model NotificationSettings {
  id              String       @id @default(uuid())
  userId          String       @unique
  emailEnabled    Boolean      @default(true)
  whatsappEnabled Boolean      @default(false)
  whatsappNumber  String?
  orderApproved   Boolean      @default(true)
  highScrapAlert  Boolean      @default(true)
  stockoutAlert   Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organizationId  String
  Organization    Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "NotificationSettings_organizationId_fk")
  User            User         @relation(fields: [userId], references: [id])

  @@index([organizationId])
}

model Organization {
  id                       String                    @id @default(uuid())
  name                     String
  code                     String                    @unique
  address                  String?
  phone                    String?
  email                    String?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  slug                     String                    @unique
  status                   OrgStatus                 @default(PENDING_APPROVAL)
  ownerUserId              String?                   @unique
  approvedAt               DateTime?
  disabledAt               DateTime?
  disabledReason           String?
  auditLogs                AuditLog[]
  bankAccounts             BankAccount[]
  billOfMaterials          BillOfMaterials[]
  Branch                   Branch[]
  chartAccounts            ChartAccount[]
  customers                Customer[]
  customerPortalAccesses   CustomerPortalAccess[]
  demandForecasts          DemandForecast[]
  designs                  Design[]
  finishedGoods            FinishedGoods[]
  importBatches            ImportBatch[]
  importRows               ImportRow[]
  inventoryFinishedGoods   InventoryFinishedGoods[]
  inventoryRawMaterials    InventoryRawMaterial[]
  Invitation               Invitation[]
  journalEntries           JournalEntry[]
  ledgerLines              LedgerLine[]
  materialConsumptionLogs  MaterialConsumptionLog[]
  materialReceipts         MaterialReceipt[]
  notificationSettings     NotificationSettings[]
  operationLogs            OperationLog[]
  payments                 Payment[]
  products                 Product[]
  productAliases           ProductAlias[]
  productReceipts          ProductReceipt[]
  productionOrders         ProductionOrder[]
  productionOrderMaterials ProductionOrderMaterial[]
  productionRoutes         ProductionRoute[]
  purchaseOrders           PurchaseOrder[]
  purchaseOrderItems       PurchaseOrderItem[]
  rawMaterials             RawMaterial[]
  routeOperations          RouteOperation[]
  saleItems                SaleItem[]
  saleOrders               SaleOrder[]
  stages                   Stage[]
  stageLogs                StageLog[]
  stockMovements           StockMovement[]
  suppliers                Supplier[]
  unitOfMeasures           UnitOfMeasure[]
  User                     User[]
}

model Product {
  id              String            @id @default(uuid())
  name            String
  sku             String?           @unique
  category        ProductCategory   @default(springs)
  origin          StockOrigin       @default(FACTORY_MADE)
  uom             String            @default("KG")
  currentStock    Float             @default(0)
  unitCost        Float?
  landingCost     Float?
  vendor          String?
  branchId        String?
  reorderLevel    Int?
  stockStatus     StockStatus?      @default(AVAILABLE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organizationId  String
  piecesSets      Int               @default(0)
  routeType       RouteType?
  Branch          Branch?           @relation(fields: [branchId], references: [id])
  Organization    Organization      @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "Product_organizationId_fk")
  ProductAlias    ProductAlias[]
  ProductReceipt  ProductReceipt[]
  ProductionOrder ProductionOrder[]
  StockMovement   StockMovement[]

  @@unique([organizationId, sku], map: "Product_org_sku_key")
  @@index([organizationId])
}

model ProductAlias {
  id             String       @id @default(uuid())
  product_id     String
  alias          String
  created_at     DateTime     @default(now())
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "ProductAlias_organizationId_fk")
  Product        Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, alias])
  @@index([alias])
  @@index([organizationId])
}

model ProductReceipt {
  id             String       @id @default(uuid())
  productId      String
  qtyReceived    Float
  unitCost       Float?
  landingCost    Float?
  reference      String?
  vendor         String?
  loggedBy       String?
  branchId       String?
  createdAt      DateTime     @default(now())
  organizationId String
  Branch         Branch?      @relation(fields: [branchId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "ProductReceipt_organizationId_fk")
  Product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model ProductionOrder {
  id                     String                    @id @default(uuid())
  orderNumber            String                    @unique
  designId               String?
  quantity               Int                       @default(1)
  targetKg               Decimal                   @db.Decimal(10, 4)
  status                 ProductionStatus          @default(PENDING)
  priority               Priority                  @default(MEDIUM)
  currentStage           Int                       @default(1)
  currentDept            String?
  assignedTo             String?
  approvedBy             String?
  approvedAt             DateTime?
  completedAt            DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  organizationId         String
  saleOrderId            String?
  saleItemId             String?                   @unique
  rejectionReason        String?
  productName            String?
  expectedPieces         Int?
  actualPieces           Int?
  actualWeightOut        Decimal?                  @db.Decimal(10, 4)
  outputRecordedAt       DateTime?
  outputRecordedBy       String?
  productId              String?
  routeType              RouteType?
  productionStartedAt    DateTime?
  productionFinishedAt   DateTime?
  notes                  String?
  MaterialConsumptionLog MaterialConsumptionLog[]
  operationLogs          OperationLog[]
  design                 Design?                   @relation(fields: [designId], references: [id], onDelete: Restrict)
  Organization           Organization              @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "ProductionOrder_organizationId_fk")
  product                Product?                  @relation(fields: [productId], references: [id])
  saleItem               SaleItem?                 @relation(fields: [saleItemId], references: [id])
  saleOrder              SaleOrder?                @relation(fields: [saleOrderId], references: [id])
  materials              ProductionOrderMaterial[]
  StageLog               StageLog[]

  @@unique([organizationId, orderNumber], map: "ProductionOrder_org_orderNumber_key")
  @@index([organizationId])
  @@index([saleOrderId])
  @@index([productId])
}

model ProductionRoute {
  id             String           @id @default(uuid())
  organizationId String
  routeType      RouteType
  name           String
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Organization   Organization     @relation(fields: [organizationId], references: [id])
  operations     RouteOperation[]

  @@unique([organizationId, routeType])
  @@index([organizationId])
}

model RouteOperation {
  id             String          @id @default(uuid())
  organizationId String
  routeId        String
  name           String
  sequence       Int
  optional       Boolean         @default(false)
  section        String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  operationLogs  OperationLog[]
  Organization   Organization    @relation(fields: [organizationId], references: [id])
  route          ProductionRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, sequence])
  @@index([organizationId])
  @@index([routeId])
}

model OperationLog {
  id                String          @id @default(uuid())
  organizationId    String
  productionOrderId String
  routeOperationId  String?
  operationName     String
  sequence          Int
  section           String?
  optional          Boolean         @default(false)
  status            OperationStatus @default(PENDING)
  startedAt         DateTime?
  completedAt       DateTime?
  durationSeconds   Int?
  operatorId        String?
  notes             String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  Operator          User?           @relation(fields: [operatorId], references: [id])
  Organization      Organization    @relation(fields: [organizationId], references: [id])
  ProductionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  RouteOperation    RouteOperation? @relation(fields: [routeOperationId], references: [id])

  @@unique([productionOrderId, sequence])
  @@index([organizationId])
  @@index([productionOrderId])
}

model ProductionOrderMaterial {
  id                String          @id @default(uuid())
  organizationId    String
  productionOrderId String
  rawMaterialId     String
  cutLength         Decimal?        @db.Decimal(10, 4)
  pieces            Int
  totalLength       Decimal?        @db.Decimal(10, 4)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  weightKg          Decimal?        @db.Decimal(10, 4)
  Organization      Organization    @relation(fields: [organizationId], references: [id])
  ProductionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  RawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])

  @@index([organizationId])
  @@index([productionOrderId])
  @@index([rawMaterialId])
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  poNumber          String              @unique
  supplierId        String
  status            PurchaseStatus      @default(DRAFT)
  totalAmount       Decimal             @db.Decimal(10, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  approvedBy        String?
  approvedAt        DateTime?
  expectedDelivery  DateTime?
  notes             String?
  organizationId    String
  Payment           Payment[]
  Organization      Organization        @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "PurchaseOrder_organizationId_fk")
  Supplier          Supplier            @relation(fields: [supplierId], references: [id])
  PurchaseOrderItem PurchaseOrderItem[]

  @@unique([organizationId, poNumber], map: "PurchaseOrder_org_poNumber_key")
  @@index([organizationId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  rawMaterialId   String
  quantity        Decimal       @db.Decimal(10, 4)
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  organizationId  String
  Organization    Organization  @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "PurchaseOrderItem_organizationId_fk")
  PurchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  RawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])

  @@index([organizationId])
}

model RawMaterial {
  id                      String                    @id @default(uuid())
  sku                     String                    @unique
  materialName            String
  diameter                String
  supplierId              String?
  barcode                 String?                   @unique
  batchNumber             String?
  availableKg             Decimal                   @default(0) @db.Decimal(10, 4)
  reservedKg              Decimal                   @default(0) @db.Decimal(10, 4)
  costPerKg               Float?
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt
  organizationId          String
  category                String                    @default("Flat Bars")
  length                  String                    @default("")
  width                   String                    @default("")
  height                  String                    @default("")
  availablePieces         Int                       @default(0)
  BillOfMaterials         BillOfMaterials[]
  DemandForecast          DemandForecast[]
  InventoryRawMaterial    InventoryRawMaterial[]
  MaterialConsumptionLog  MaterialConsumptionLog[]
  MaterialReceipt         MaterialReceipt[]
  ProductionOrderMaterial ProductionOrderMaterial[]
  PurchaseOrderItem       PurchaseOrderItem[]
  Organization            Organization              @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "RawMaterial_organizationId_fk")
  Supplier                Supplier?                 @relation(fields: [supplierId], references: [id])

  @@unique([organizationId, barcode], map: "RawMaterial_org_barcode_key")
  @@unique([organizationId, sku], map: "RawMaterial_org_sku_key")
  @@index([organizationId])
}

model SaleItem {
  id              String           @id @default(uuid())
  saleOrderId     String
  finishedGoodsId String
  quantity        Int
  unitPrice       Decimal          @db.Decimal(10, 2)
  totalPrice      Decimal          @db.Decimal(10, 2)
  organizationId  String
  ProductionOrder ProductionOrder?
  FinishedGoods   FinishedGoods    @relation(fields: [finishedGoodsId], references: [id])
  Organization    Organization     @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "SaleItem_organizationId_fk")
  SaleOrder       SaleOrder        @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model SaleOrder {
  id              String            @id @default(uuid())
  customerId      String?
  customerName    String
  totalAmount     Decimal           @db.Decimal(10, 2)
  status          SaleStatus        @default(PENDING)
  createdBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organizationId  String
  Payment         Payment[]
  ProductionOrder ProductionOrder[]
  SaleItem        SaleItem[]
  createdByUser   User?             @relation(fields: [createdBy], references: [id])
  Customer        Customer?         @relation(fields: [customerId], references: [id])
  Organization    Organization      @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "SaleOrder_organizationId_fk")

  @@index([organizationId])
}

model Stage {
  id                     String                   @id @default(uuid())
  name                   String
  department             String
  sequence               Int
  designId               String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  organizationId         String
  specifications         Json?
  MaterialConsumptionLog MaterialConsumptionLog[]
  design                 Design                   @relation(fields: [designId], references: [id], onDelete: Cascade)
  Organization           Organization             @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "Stage_organizationId_fk")
  StageLog               StageLog[]

  @@unique([designId, sequence])
  @@index([organizationId])
}

model StageLog {
  id              String          @id @default(uuid())
  orderId         String
  stageId         String?
  stageName       String
  sequence        Int
  kgIn            Decimal         @db.Decimal(10, 4)
  kgOut           Decimal         @db.Decimal(10, 4)
  kgScrap         Decimal         @db.Decimal(10, 4)
  scrapReason     String?
  department      String?
  operatorId      String
  notes           String?
  completedAt     DateTime        @default(now())
  organizationId  String
  piecesIn        Int?
  piecesOut       Int?
  User            User            @relation(fields: [operatorId], references: [id])
  ProductionOrder ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Organization    Organization    @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "StageLog_organizationId_fk")
  Stage           Stage?          @relation(fields: [stageId], references: [id])

  @@index([organizationId])
}

model Supplier {
  id              String            @id @default(uuid())
  name            String
  code            String            @unique
  contactName     String?
  email           String?
  phone           String?
  address         String?
  taxId           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  organizationId  String
  MaterialReceipt MaterialReceipt[]
  Payment         Payment[]
  PurchaseOrder   PurchaseOrder[]
  RawMaterial     RawMaterial[]
  Organization    Organization      @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "Supplier_organizationId_fk")

  @@unique([organizationId, code], map: "Supplier_org_code_key")
  @@index([organizationId])
}

model UnitOfMeasure {
  id             String       @id @default(uuid())
  name           String
  symbol         String
  category       String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organizationId String
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "UnitOfMeasure_organizationId_fk")

  @@index([organizationId])
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  password             String?
  name                 String?
  role                 Role                  @default(PENDING)
  department           String?
  organizationId       String?
  branchId             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  lastSeenAt           DateTime?
  departments          String[]              @default([])
  AuditLog             AuditLog[]
  ImportBatch          ImportBatch[]
  SentInvitations      Invitation[]          @relation("Inviter")
  NotificationSettings NotificationSettings?
  OperationLog         OperationLog[]
  SaleOrderCreated     SaleOrder[]
  StageLog             StageLog[]
  Branch               Branch?               @relation(fields: [branchId], references: [id])
  Organization         Organization?         @relation(fields: [organizationId], references: [id])
}

model Invitation {
  id             String       @id @default(uuid())
  organizationId String
  email          String
  role           Role         @default(OPERATOR)
  branchId       String?
  token          String       @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  cancelledAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Branch         Branch?      @relation(fields: [branchId], references: [id], onUpdate: NoAction, map: "Invitation_branch_fk")
  InvitedByUser  User         @relation("Inviter", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "Invitation_inviter_fk")
  Organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "Invitation_org_fk")

  @@unique([organizationId, email], map: "Invitation_org_email_key")
  @@index([organizationId])
  @@index([token])
}

model StockMovement {
  id             String       @id @default(uuid())
  productId      String
  branchId       String?
  movementType   String
  quantity       Float
  reference      String?
  notes          String?
  createdAt      DateTime     @default(now())
  organizationId String
  Branch         Branch?      @relation(fields: [branchId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction, map: "StockMovement_organizationId_fk")
  Product        Product      @relation(fields: [productId], references: [id])

  @@index([organizationId])
}

model ChartAccount {
  id             String         @id @default(uuid())
  organizationId String
  code           String
  name           String
  type           AccountType
  normalBalance  NormalBalance
  classification AccountClassification?
  statementGroup StatementGroup?
  currency       String         @default("KES")
  branchId       String?
  parentId       String?
  isBank         Boolean        @default(false)
  isSystem       Boolean        @default(false)
  isActive       Boolean        @default(true)
  description    String?
  note           String?
  vatApplicable  Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  bankAccount    BankAccount?
  Branch         Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  Organization   Organization   @relation(fields: [organizationId], references: [id])
  parent         ChartAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children       ChartAccount[] @relation("AccountTree")
  ledgerLines    LedgerLine[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([organizationId, branchId])
  @@index([organizationId, type])
}

model JournalEntry {
  id             String        @id @default(uuid())
  organizationId String
  entryNumber    String
  date           DateTime
  memo           String?
  status         JournalStatus @default(POSTED)
  source         JournalSource @default(MANUAL)
  sourceType     String?
  sourceId       String?
  branchId       String?
  postedAt       DateTime?
  postedBy       String?
  createdBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  Branch         Branch?       @relation(fields: [branchId], references: [id])
  Organization   Organization  @relation(fields: [organizationId], references: [id])
  lines          LedgerLine[]
  payments       Payment[]

  @@unique([organizationId, entryNumber])
  @@unique([organizationId, source, sourceType, sourceId], map: "JournalEntry_org_source_sourcetype_sourceid_key")
  @@index([organizationId])
  @@index([organizationId, date])
  @@index([organizationId, branchId])
  @@index([sourceType, sourceId])
}

model LedgerLine {
  id             String       @id @default(uuid())
  organizationId String
  journalEntryId String
  accountId      String
  debit          Decimal      @default(0) @db.Decimal(14, 2)
  credit         Decimal      @default(0) @db.Decimal(14, 2)
  description    String?
  createdAt      DateTime     @default(now())
  account        ChartAccount @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([accountId])
  @@index([journalEntryId])
}

model BankAccount {
  id             String       @id @default(uuid())
  organizationId String
  accountId      String       @unique
  name           String
  bankName       String?
  accountNumber  String?
  currency       String       @default("KES")
  openingBalance Decimal      @default(0) @db.Decimal(14, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  account        ChartAccount @relation(fields: [accountId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])
  payments       Payment[]

  @@index([organizationId])
}

model Payment {
  id              String           @id @default(uuid())
  organizationId  String
  paymentNumber   String
  direction       PaymentDirection
  method          PaymentMethod    @default(BANK_TRANSFER)
  date            DateTime
  amount          Decimal          @db.Decimal(14, 2)
  reference       String?
  notes           String?
  customerId      String?
  supplierId      String?
  saleOrderId     String?
  purchaseOrderId String?
  bankAccountId   String?
  journalEntryId  String?
  createdBy       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bankAccount     BankAccount?     @relation(fields: [bankAccountId], references: [id])
  Customer        Customer?        @relation(fields: [customerId], references: [id])
  journalEntry    JournalEntry?    @relation(fields: [journalEntryId], references: [id])
  Organization    Organization     @relation(fields: [organizationId], references: [id])
  PurchaseOrder   PurchaseOrder?   @relation(fields: [purchaseOrderId], references: [id])
  SaleOrder       SaleOrder?       @relation(fields: [saleOrderId], references: [id])
  Supplier        Supplier?        @relation(fields: [supplierId], references: [id])

  @@unique([organizationId, paymentNumber])
  @@index([organizationId])
  @@index([organizationId, direction])
  @@index([customerId])
  @@index([supplierId])
  @@index([saleOrderId])
  @@index([purchaseOrderId])
}

model ProductMaster {
  name          String
  location      String
  category      String
  opening_stock Decimal  @default(0) @db.Decimal(12, 2)
  current_stock Decimal  @default(0) @db.Decimal(12, 2)
  created_at    DateTime @default(now())
  updated_at    DateTime

  @@id([name, location])
  @@index([location])
}

model SalesTransaction {
  id               String   @id
  product_name     String
  quantity         Decimal  @db.Decimal(12, 2)
  transaction_date DateTime
  invoice_number   String?
  customer_name    String?
  location         String
  created_at       DateTime @default(now())

  @@index([location])
  @@index([transaction_date])
}

model StockReceipt {
  id               String   @id
  product_name     String
  quantity         Decimal  @db.Decimal(12, 2)
  transaction_date DateTime
  reference_memo   String?
  location         String
  created_at       DateTime @default(now())

  @@index([location])
  @@index([transaction_date])
}

model inventory_transactions {
  id               String   @id
  product_name     String
  quantity         Float
  transaction_date DateTime @db.Timestamp(6)
  reference_memo   String?
  location         String?
  created_at       DateTime @db.Timestamp(6)
}

