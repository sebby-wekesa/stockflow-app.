generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN      // Can see reports, manage BOM, and release orders
  MANAGER    // Can approve and manage production orders
  OPERATOR   // Can only see their department queue and log weights
  SALES      // Can view sales-related data
  PACKAGING  // Can handle packaging operations
  WAREHOUSE  // Can only log raw material intake
}

enum ProductionStatus {
  PENDING       // Waiting for Manager Review
  APPROVED      // Released to production [cite: 46]
  IN_PRODUCTION // Moving through departments [cite: 47]
  COMPLETED     // Finished goods added to stock [cite: 48]
  REJECTED      // Sent back by Manager [cite: 51]
  CANCELLED
}

enum ScrapReason {
  MACHINE_FAULT    // Tool breakage, equipment issues
  MATERIAL_DEFECT  // Cracked rod, poor quality material
  HUMAN_ERROR      // Incorrect settings, operator mistakes
  PROCESS_LOSS     // Standard swarf, off-cuts, normal waste
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum BranchEnum {
  mombasa
  nairobi
  bonje
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  password        String
  name            String?
  role            Role       @default(OPERATOR)
  department      String?    // e.g., "Cutting", "Forging" (for Operators)
  branchId        String?    // Branch assignment for stock access
  branch          Branch?    @relation(fields: [branchId], references: [id])
  organizationId  String?
  organization    Organization? @relation(fields: [organizationId], references: [id])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  stageLogs       StageLog[]
  saleOrders      SaleOrder[]
  stockMovements  StockMovement[]
  stockAdjustments StockAdjustment[]
}

model Design {
  id               String            @id @default(cuid())
  name             String            // e.g., Hex Bolt M12 [cite: 67]
  code             String            @unique // e.g., HB-M12 [cite: 74]
  description      String?
  targetDimensions String?           // Stores specs like 12mm x 70mm [cite: 71]
  targetWeight     Float?            // Estimated yield kg per unit [cite: 135]
  // New Phase 2 Fields
  rawMaterialId    String?           // Links to the specific rod needed (e.g., M12 High Tensile)
  kgPerUnit        Float             @default(0.0) // The BOM consumption rate
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  stages           Stage[]
  productionOrders ProductionOrder[]

  finishedGoods    FinishedGood[]
}

model Stage {
  id          String     @id @default(cuid())
  name        String     // e.g., Cutting, Forging, Threading [cite: 65]
  department  String     // The department responsible for this stage [cite: 65]
  sequence    Int        // Order of operations [cite: 68]
  designId    String
  design      Design     @relation(fields: [designId], references: [id], onDelete: Cascade)
  stageLogs   StageLog[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([designId, sequence])
}

model ProductionOrder {
  id            String           @id @default(cuid())
  orderNumber   String           @unique // e.g., PO-0040 [cite: 93]
  designId      String
  design        Design           @relation(fields: [designId], references: [id])
  quantity      Int              @default(1)
  targetKg      Float            // Total initial weight (In) [cite: 55]
  status        ProductionStatus @default(PENDING)
  priority      Priority         @default(MEDIUM)

  // Handoff Tracking
  currentStage  Int              @default(1) // Current sequence number
  currentDept   String?          // Current department queue (e.g., "Cutting") [cite: 99]

  assignedTo    String?
  approvedBy    String?
  approvedAt    DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  logs          StageLog[]
  finishedGoods FinishedGood[]

  @@index([status, createdAt])
  @@index([currentDept, status])
}

model StageLog {
  id          String          @id @default(cuid())
  orderId     String
  order       ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  stageId     String?
  stage       Stage?          @relation(fields: [stageId], references: [id])
  stageName   String
  sequence    Int

  // KG Traceability: Enforces In = Out + Scrap [cite: 55, 78]
  kgIn        Float           // Weight received from previous stage [cite: 77]
  kgOut       Float           // Weight passed forward [cite: 77]
  kgScrap     Float           // Weight lost [cite: 77]
  scrapReason ScrapReason?    // Categorized reason for scrap [cite: 65, 153]
  department  String?         // Department responsible for this stage log [new field]

  operatorId  String
  operator    User            @relation(fields: [operatorId], references: [id])
  notes       String?
  completedAt DateTime        @default(now())
}

model Organization {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  users     User[]
  branches  Branch[]
}

model Branch {
  id             String       @id @default(cuid())
  branch         BranchEnum   @unique
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  users          User[]
  stockMovements StockMovement[]
  stockAdjustments StockAdjustment[]
}

model Product {
  id               String         @id @default(cuid())
  code             String         @unique
  name             String
  category         String         // e.g., 'manufactured', 'imported', 'local'
  reorderPoint     Int            @default(0)
  sellingPrice     Float          @default(0)
  isService        Boolean        @default(false) // Excludes from stock operations
  isActive         Boolean        @default(true)
  uom              String?        // Unit of measure
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  branchStocks     BranchStock[]
  stockMovements   StockMovement[]
  stockAdjustments StockAdjustment[]
  saleOrderLines   SaleOrderLine[]
}

model Supplier {
  id             String                @id @default(cuid())
  name           String
  contactInfo    String?
  rawMaterials   RawMaterial[]
  receipts       RawMaterialReceipt[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model Customer {
  id        String     @id @default(cuid())
  name      String
  contactInfo String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  saleOrders SaleOrder[]
}

model Item {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?  // e.g., "Raw Material", "Finished Good"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RawMaterial {
  id            String                @id @default(cuid())
  materialName  String                // e.g., "High-Tensile Steel"
  diameter      String                // e.g., "M12"
  availableKg   Float                 @default(0) // Available for reservation
  reservedKg    Float                 @default(0) // Reserved for production
  supplierId    String?
  supplier      Supplier?             @relation(fields: [supplierId], references: [id])
  receipts      RawMaterialReceipt[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
}

model RawMaterialReceipt {
  id            String       @id @default(cuid())
  rawMaterialId String
  rawMaterial   RawMaterial  @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  quantity      Float        // kg received
  supplierId    String?
  supplier      Supplier?    @relation(fields: [supplierId], references: [id])
  receivedAt    DateTime     @default(now())
}

model FinishedGood {
  id                String          @id @default(cuid())
  designId          String
  design            Design          @relation(fields: [designId], references: [id])
  productionOrderId String?
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  quantity          Int
  location          String?         // branch or warehouse
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

enum SaleStatus {
  DRAFT       // Saved but not invoiced
  INVOICED    // Invoiced with stock deduction
  FULFILLED   // Completed
  CANCELLED
}

model SaleOrder {
  id             String     @id @default(cuid())
  orderNumber    String?    @unique // e.g., INV-MOM-0001
  branch         BranchEnum
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  status         SaleStatus @default(DRAFT)
  orderDate      DateTime   @default(now())
  salesRepId     String     // User who created the order
  salesRep       User       @relation(fields: [salesRepId], references: [id])
  notes          String?
  totalAmount    Float      @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lines          SaleOrderLine[]

}

model SaleOrderLine {
  id          String    @id @default(cuid())
  saleOrderId String
  saleOrder   SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Int
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime  @default(now())
}

model StockTransaction {
  id             String   @id @default(cuid())
  itemType       String   // 'raw' or 'finished'
  itemId         String   // rawMaterialId or finishedGoodId
  transactionType String  // 'receipt', 'consumption', 'sale', etc.
  quantity       Float
  reason         String?
  performedBy    String   // userId
  createdAt      DateTime @default(now())
}

model BranchStock {
  id        String     @id @default(cuid())
  productId String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  branch    BranchEnum
  qty       Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@unique([productId, branch])
}

model StockMovement {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId     String
  branch       Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  qty          Int       // Positive for in, negative for out
  type         String    // e.g., 'purchase_in', 'sale_out', 'adjustment_in', 'branch_transfer_in'
  reference    String?   // e.g., PO number, import batch
  notes        String?
  userId       String
  user         User      @relation(fields: [userId], references: [id])
  batchId      String?   // For import batches
  sourceBranch BranchEnum? // For transfers
  destBranch   BranchEnum? // For transfers
  createdAt    DateTime  @default(now())
}

model StockAdjustment {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  oldQty    Int
  newQty    Int
  delta     Int
  reason    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}