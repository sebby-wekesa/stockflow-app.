model AuditLog {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  action         String
  entityType     String?
  entityId       String?
  details        String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  User           User     @relation(fields: [userId], references: [id])

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model BillOfMaterials {
  id             String       @id @default(uuid())
  organizationId String
  designId       String
  rawMaterialId  String
  quantity       Decimal      @db.Decimal(10, 4)
  unitOfMeasure  String       @default("kg")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  design         Design       @relation(fields: [designId], references: [id], onDelete: Cascade)
  RawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([designId, rawMaterialId])
  @@index([organizationId])
}

model Branch {
  id                     String                   @id @default(uuid())
  organizationId         String
  name                   String
  location               String?
  code                   String
  address                String?
  phone                  String?
  managerId              String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  Organization           Organization             @relation(fields: [organizationId], references: [id])
  InventoryFinishedGoods InventoryFinishedGoods[]
  InventoryRawMaterial   InventoryRawMaterial[]
  MaterialReceipt        MaterialReceipt[]
  Product                Product[]
  ProductReceipt         ProductReceipt[]
  StockMovement          StockMovement[]
  User                   User[]
  Invitation             Invitation[]

  @@unique([organizationId, name])
  @@unique([organizationId, code])
}

model Customer {
  id                   String                @id @default(uuid())
  organizationId       String
  name                 String
  code                 String
  contactName          String?
  email                String?
  phone                String?
  address              String?
  taxId                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  CustomerPortalAccess CustomerPortalAccess?
  SaleOrder            SaleOrder[]

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
}

model CustomerPortalAccess {
  id             String    @id @default(uuid())
  organizationId String
  customerId     String    @unique
  accessCode     String    @unique
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  lastLogin      DateTime?
  Customer       Customer  @relation(fields: [customerId], references: [id])

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model DemandForecast {
  id               String       @id @default(uuid())
  organizationId   String
  rawMaterialId    String
  forecastDate     DateTime
  forecastedDemand Decimal      @db.Decimal(10, 4)
  confidenceLevel  Float
  basedOnDays      Int
  createdAt        DateTime     @default(now())
  RawMaterial      RawMaterial  @relation(fields: [rawMaterialId], references: [id])
  Organization     Organization @relation(fields: [organizationId], references: [id])

  @@unique([rawMaterialId, forecastDate])
  @@index([organizationId])
}

model Design {
  id               String            @id @default(uuid())
  organizationId   String
  name             String
  code             String
  category         String?
  description      String?
  targetDimensions String?
  targetWeight     Decimal?          @db.Decimal(10, 4)
  expectedYield    Float?
  specifications   Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lastSeenAt       DateTime?
  billOfMaterials  BillOfMaterials[]
  finishedGoods    FinishedGoods[]
  productionOrders ProductionOrder[]
  stages           Stage[]

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
}

model FinishedGoods {
  id                     String                   @id @default(uuid())
  organizationId         String
  sku                    String
  designId               String
  quantity               Int
  reservedQuantity       Int                      @default(0)
  kgProduced             Decimal                  @db.Decimal(10, 4)
  barcode                String?
  batchNumber            String?
  unitCost               Float?
  createdAt              DateTime                 @default(now())
  design                 Design                   @relation(fields: [designId], references: [id])
  InventoryFinishedGoods InventoryFinishedGoods[]
  SaleItem               SaleItem[]

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
}

model ImportBatch {
  id             String       @id @default(uuid())
  organizationId String
  file_name      String
  file_url       String? // base64 buffer for re-parsing on commit (cleared after success)
  sheet_type     String
  import_mode    ImportMode   @default(update)
  target_branch  String?
  status         ImportStatus @default(uploaded)
  row_count      Int
  mapping_config Json? // specialized import metadata (preview rows, source label)
  imported_at    DateTime?
  ok_count       Int?
  skipped_count  Int?
  error_count    Int?
  error_summary  String?
  created_by     String
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  User           User         @relation(fields: [created_by], references: [id])
  ImportRow      ImportRow[]

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model ImportRow {
  id               String       @id @default(uuid())
  organizationId   String
  batch_id         String
  row_number       Int
  raw_data         Json
  mapped_data      Json?
  matched_product  String?
  match_confidence Float?
  resolution       String?
  resolved_product String?
  order_number     String?
  customer_name    String?
  qty              Float?
  unit_price       Float?
  notes            String?
  errors           String?
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  ImportBatch      ImportBatch  @relation(fields: [batch_id], references: [id], onDelete: Cascade)
  Organization     Organization @relation(fields: [organizationId], references: [id])

  @@index([batch_id])
  @@index([organizationId])
}

model InventoryFinishedGoods {
  id              String        @id @default(uuid())
  organizationId  String
  branchId        String
  finishedGoodsId String
  availableQty    Int           @default(0)
  reservedQty     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  Branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  FinishedGoods   FinishedGoods @relation(fields: [finishedGoodsId], references: [id], onDelete: Cascade)
  Organization    Organization  @relation(fields: [organizationId], references: [id])

  @@unique([branchId, finishedGoodsId])
  @@index([organizationId])
}

model InventoryRawMaterial {
  id             String       @id @default(uuid())
  organizationId String
  branchId       String
  rawMaterialId  String
  availableKg    Decimal      @default(0) @db.Decimal(10, 4)
  reservedKg     Decimal      @default(0) @db.Decimal(10, 4)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  RawMaterial    RawMaterial  @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([branchId, rawMaterialId])
  @@index([organizationId])
}

model MaterialConsumptionLog {
  id                String          @id @default(uuid())
  organizationId    String
  productionOrderId String
  rawMaterialId     String
  quantityConsumed  Decimal         @db.Decimal(10, 4)
  consumedAt        DateTime        @default(now())
  stageId           String?
  notes             String?
  ProductionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  RawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  Stage             Stage?          @relation(fields: [stageId], references: [id])

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model MaterialReceipt {
  id             String      @id @default(uuid())
  organizationId String
  materialId     String
  kgReceived     Decimal     @db.Decimal(10, 4)
  piecesReceived Int         @default(0)
  reference      String?
  supplierId     String?
  branchId       String?
  loggedBy       String?
  createdAt      DateTime    @default(now())
  Branch         Branch?     @relation(fields: [branchId], references: [id])
  RawMaterial    RawMaterial @relation(fields: [materialId], references: [id])
  Supplier       Supplier?   @relation(fields: [supplierId], references: [id])

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model NotificationSettings {
  id              String   @id @default(uuid())
  organizationId  String
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  whatsappNumber  String?
  orderApproved   Boolean  @default(true)
  highScrapAlert  Boolean  @default(true)
  stockoutAlert   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  User            User     @relation(fields: [userId], references: [id])

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Organization {
  id             String       @id @default(uuid())
  name           String
  slug           String       @unique // url-safe identifier, e.g. "acme-springs"
  status         OrgStatus    @default(PENDING_APPROVAL)
  ownerUserId    String?      @unique
  approvedAt     DateTime?
  disabledAt     DateTime?
  disabledReason String?
  code           String       @unique
  address        String?
  phone          String?
  email          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  Branch         Branch[]
  User           User[]
  Invitation     Invitation[]

  // Inverse relations for all models with organizationId (required by Prisma for the @relation)
  auditLogs               AuditLog[]
  billOfMaterials         BillOfMaterials[]
  customers               Customer[]
  customerPortalAccesses  CustomerPortalAccess[]
  demandForecasts         DemandForecast[]
  designs                 Design[]
  finishedGoods           FinishedGoods[]
  importBatches           ImportBatch[]
  importRows              ImportRow[]
  inventoryFinishedGoods  InventoryFinishedGoods[]
  inventoryRawMaterials   InventoryRawMaterial[]
  materialConsumptionLogs MaterialConsumptionLog[]
  materialReceipts        MaterialReceipt[]
  notificationSettings    NotificationSettings[]
  products                Product[]
  productAliases          ProductAlias[]
  productReceipts         ProductReceipt[]
  productionOrderMaterials ProductionOrderMaterial[]
  productionOrders        ProductionOrder[]
  purchaseOrders          PurchaseOrder[]
  purchaseOrderItems      PurchaseOrderItem[]
  rawMaterials            RawMaterial[]
  saleItems               SaleItem[]
  saleOrders              SaleOrder[]
  stages                  Stage[]
  stageLogs               StageLog[]
  stockMovements          StockMovement[]
  suppliers               Supplier[]
  unitOfMeasures          UnitOfMeasure[]
}

model Product {
  id             String           @id @default(uuid())
  organizationId String
  name           String
  sku            String?
  category       ProductCategory  @default(springs)
  origin         StockOrigin      @default(FACTORY_MADE)
  uom            String           @default("KG")
  currentStock   Float            @default(0)
  piecesSets     Int              @default(0)
  unitCost       Float?
  landingCost    Float?
  vendor         String?
  branchId       String?
  reorderLevel   Int? // Minimum stock level before reorder
  stockStatus    StockStatus?     @default(AVAILABLE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Branch         Branch?          @relation(fields: [branchId], references: [id])
  ProductAlias   ProductAlias[]
  ProductReceipt ProductReceipt[]
  StockMovement  StockMovement[]

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sku])
  @@index([organizationId])
}

model ProductAlias {
  id             String       @id @default(uuid())
  organizationId String
  product_id     String
  alias          String
  created_at     DateTime     @default(now())
  Product        Product      @relation(fields: [product_id], references: [id], onDelete: Cascade)
  Organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([product_id, alias])
  @@index([alias])
  @@index([organizationId])
}

model ProductReceipt {
  id             String   @id @default(uuid())
  organizationId String
  productId      String
  qtyReceived    Float
  unitCost       Float?
  landingCost    Float?
  reference      String?
  vendor         String?
  loggedBy       String?
  branchId       String?
  createdAt      DateTime @default(now())
  Branch         Branch?  @relation(fields: [branchId], references: [id])
  Product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model ProductionOrder {
  id                     String                   @id @default(uuid())
  organizationId         String
  saleOrderId            String?
  saleItemId             String?                  @unique
  orderNumber            String
  designId               String?
  productName            String?
  expectedPieces         Int?
  actualPieces           Int?
  actualWeightOut        Decimal?                 @db.Decimal(10, 4)
  outputRecordedAt       DateTime?
  outputRecordedBy       String?
  quantity               Int                      @default(1)
  targetKg               Decimal                  @db.Decimal(10, 4)
  status                 ProductionStatus         @default(PENDING)
  priority               Priority                 @default(MEDIUM)
  currentStage           Int                      @default(1)
  currentDept            String?
  assignedTo             String?
  approvedBy             String?
  approvedAt             DateTime?
  rejectionReason        String?
  completedAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  MaterialConsumptionLog MaterialConsumptionLog[]
  design                 Design?                  @relation(fields: [designId], references: [id])
  materials              ProductionOrderMaterial[]
  saleOrder              SaleOrder?               @relation(fields: [saleOrderId], references: [id])
  saleItem               SaleItem?                @relation(fields: [saleItemId], references: [id])
  StageLog               StageLog[]

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([saleOrderId])
}

model ProductionOrderMaterial {
  id                String          @id @default(uuid())
  organizationId    String
  productionOrderId String
  rawMaterialId     String
  cutLength         Decimal?        @db.Decimal(10, 4)
  pieces            Int
  totalLength       Decimal?        @db.Decimal(10, 4)
  weightKg          Decimal?        @db.Decimal(10, 4)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  ProductionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  RawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  Organization      Organization    @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([productionOrderId])
  @@index([rawMaterialId])
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  organizationId    String
  poNumber          String
  supplierId        String
  status            PurchaseStatus      @default(DRAFT)
  totalAmount       Decimal             @db.Decimal(10, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  approvedBy        String?
  approvedAt        DateTime?
  expectedDelivery  DateTime?
  notes             String?
  Supplier          Supplier            @relation(fields: [supplierId], references: [id])
  PurchaseOrderItem PurchaseOrderItem[]

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, poNumber])
  @@index([organizationId])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  organizationId  String
  purchaseOrderId String
  rawMaterialId   String
  quantity        Decimal       @db.Decimal(10, 4)
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  PurchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  RawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model RawMaterial {
  id                     String                   @id @default(uuid())
  organizationId         String
  sku                    String
  materialName           String
  category               String                   @default("Flat Bars")
  diameter               String
  length                 String                   @default("")
  width                  String                   @default("")
  height                 String                   @default("")
  supplierId             String?
  barcode                String?
  batchNumber            String?
  availableKg            Decimal                  @default(0) @db.Decimal(10, 4)
  reservedKg             Decimal                  @default(0) @db.Decimal(10, 4)
  availablePieces        Int                      @default(0)
  costPerKg              Float?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  BillOfMaterials        BillOfMaterials[]
  DemandForecast         DemandForecast[]
  InventoryRawMaterial   InventoryRawMaterial[]
  MaterialConsumptionLog MaterialConsumptionLog[]
  MaterialReceipt        MaterialReceipt[]
  ProductionOrderMaterial ProductionOrderMaterial[]
  PurchaseOrderItem      PurchaseOrderItem[]
  Supplier               Supplier?                @relation(fields: [supplierId], references: [id])

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, sku])
  @@unique([organizationId, barcode])
  @@index([organizationId])
}

model SaleItem {
  id              String        @id @default(uuid())
  organizationId  String
  saleOrderId     String
  finishedGoodsId String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  FinishedGoods   FinishedGoods @relation(fields: [finishedGoodsId], references: [id])
  ProductionOrder ProductionOrder?
  SaleOrder       SaleOrder     @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model SaleOrder {
  id             String     @id @default(uuid())
  organizationId String
  customerId     String?
  customerName   String
  totalAmount    Decimal    @db.Decimal(10, 2)
  status         SaleStatus @default(PENDING)
  createdBy      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  SaleItem       SaleItem[]
  ProductionOrder ProductionOrder[]
  Customer       Customer?  @relation(fields: [customerId], references: [id])
  createdByUser  User?      @relation(fields: [createdBy], references: [id])

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Stage {
  id                     String                   @id @default(uuid())
  organizationId         String
  name                   String
  department             String
  sequence               Int
  specifications         Json?
  designId               String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  MaterialConsumptionLog MaterialConsumptionLog[]
  design                 Design                   @relation(fields: [designId], references: [id], onDelete: Cascade)
  StageLog               StageLog[]
  Organization           Organization             @relation(fields: [organizationId], references: [id])

  @@unique([designId, sequence])
  @@index([organizationId])
}

model StageLog {
  id              String          @id @default(uuid())
  organizationId  String
  orderId         String
  stageId         String?
  stageName       String
  sequence        Int
  kgIn            Decimal         @db.Decimal(10, 4)
  kgOut           Decimal         @db.Decimal(10, 4)
  kgScrap         Decimal         @db.Decimal(10, 4)
  piecesIn        Int?
  piecesOut       Int?
  scrapReason     String?
  department      String?
  operatorId      String
  notes           String?
  completedAt     DateTime        @default(now())
  User            User            @relation(fields: [operatorId], references: [id])
  ProductionOrder ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Stage           Stage?          @relation(fields: [stageId], references: [id])

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Supplier {
  id              String            @id @default(uuid())
  organizationId  String
  name            String
  code            String
  contactName     String?
  email           String?
  phone           String?
  address         String?
  taxId           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  MaterialReceipt MaterialReceipt[]
  PurchaseOrder   PurchaseOrder[]
  RawMaterial     RawMaterial[]

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
}

model UnitOfMeasure {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  symbol         String
  category       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  Organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  password             String?
  name                 String?
  role                 Role                  @default(PENDING)
  department           String?
  departments          String[]              @default([])
  organizationId       String?
  branchId             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  lastSeenAt           DateTime?
  AuditLog             AuditLog[]
  ImportBatch          ImportBatch[]
  NotificationSettings NotificationSettings?
  StageLog             StageLog[]
  Branch               Branch?               @relation(fields: [branchId], references: [id])
  Organization         Organization?         @relation(fields: [organizationId], references: [id])
  SaleOrderCreated     SaleOrder[]

  SentInvitations Invitation[] @relation("Inviter")
}

