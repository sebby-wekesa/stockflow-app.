generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  schemas  = ["public"]
}

// ─────────────────────────────────────────────────────────────────────────────
// PUBLIC SCHEMA MODELS
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String?
  entityId   String?
  details    String?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  User       User     @relation(fields: [userId], references: [id])

  @@schema("public")
}

model BillOfMaterials {
  id            String      @id @default(uuid())
  designId      String
  rawMaterialId String
  quantity      Decimal     @db.Decimal(10, 4)
  unitOfMeasure String      @default("kg")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  design        Design      @relation(fields: [designId], references: [id], onDelete: Cascade)
  RawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@unique([designId, rawMaterialId])
  @@schema("public")
}

model Branch {
  id                     String                   @id @default(uuid())
  organizationId         String
  name                   String                   @unique
  location               String?
  code                   String                   @unique
  address                String?
  phone                  String?
  managerId              String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  Organization           Organization             @relation(fields: [organizationId], references: [id])
  InventoryFinishedGoods InventoryFinishedGoods[]
  InventoryRawMaterial   InventoryRawMaterial[]
  MaterialReceipt        MaterialReceipt[]
  Product                Product[]
  ProductReceipt         ProductReceipt[]
  StockMovement          StockMovement[]
  User                   User[]

  @@schema("public")
}

model Customer {
  id                   String                @id @default(uuid())
  name                 String
  code                 String                @unique
  contactName          String?
  email                String?
  phone                String?
  address              String?
  taxId                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  CustomerPortalAccess CustomerPortalAccess?
  SaleOrder            SaleOrder[]

  @@schema("public")
}

model CustomerPortalAccess {
  id         String    @id @default(uuid())
  customerId String    @unique
  accessCode String    @unique
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  lastLogin  DateTime?
  Customer   Customer  @relation(fields: [customerId], references: [id])

  @@schema("public")
}

model DemandForecast {
  id               String      @id @default(uuid())
  rawMaterialId    String
  forecastDate     DateTime
  forecastedDemand Decimal     @db.Decimal(10, 4)
  confidenceLevel  Float
  basedOnDays      Int
  createdAt        DateTime    @default(now())
  RawMaterial      RawMaterial @relation(fields: [rawMaterialId], references: [id])

  @@unique([rawMaterialId, forecastDate])
  @@schema("public")
}

model Design {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  description      String?
  targetDimensions String?
  targetWeight     Decimal?          @db.Decimal(10, 4)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  billOfMaterials  BillOfMaterials[]
  finishedGoods    FinishedGoods[]
  productionOrders ProductionOrder[]
  stages           Stage[]

  @@schema("public")
}

model FinishedGoods {
  id                     String                   @id @default(uuid())
  sku                    String                   @unique
  designId               String
  quantity               Int
  kgProduced             Decimal                  @db.Decimal(10, 4)
  barcode                String?                  @unique
  batchNumber            String?
  unitCost               Float?
  createdAt              DateTime                 @default(now())
  design                 Design                   @relation(fields: [designId], references: [id])
  InventoryFinishedGoods InventoryFinishedGoods[]
  SaleItem               SaleItem[]

  @@schema("public")
}

model ImportBatch {
  id             String       @id @default(uuid())
  file_name      String
  file_url       String?
  sheet_type     String
  import_mode    ImportMode   @default(update)
  target_branch  String?
  status         ImportStatus @default(uploaded)
  row_count      Int
  mapping_config Json?
  imported_at    DateTime?
  ok_count       Int?
  skipped_count  Int?
  error_count    Int?
  error_summary  String?
  created_by     String
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  User           User         @relation(fields: [created_by], references: [id])
  ImportRow      ImportRow[]

  @@schema("public")
}

model ImportRow {
  id               String      @id @default(uuid())
  batch_id         String
  row_number       Int
  raw_data         Json
  mapped_data      Json?
  matched_product  String?
  match_confidence Float?
  resolution       String?
  resolved_product String?
  order_number     String?
  customer_name    String?
  qty              Float?
  unit_price       Float?
  notes            String?
  errors           String?
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  ImportBatch      ImportBatch @relation(fields: [batch_id], references: [id], onDelete: Cascade)

  @@index([batch_id])
  @@schema("public")
}

model InventoryFinishedGoods {
  id              String        @id @default(uuid())
  branchId        String
  finishedGoodsId String
  availableQty    Int           @default(0)
  reservedQty     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  Branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  FinishedGoods   FinishedGoods @relation(fields: [finishedGoodsId], references: [id], onDelete: Cascade)

  @@unique([branchId, finishedGoodsId])
  @@schema("public")
}

model InventoryRawMaterial {
  id            String      @id @default(uuid())
  branchId      String
  rawMaterialId String
  availableKg   Decimal     @default(0) @db.Decimal(10, 4)
  reservedKg    Decimal     @default(0) @db.Decimal(10, 4)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  Branch        Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  RawMaterial   RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@unique([branchId, rawMaterialId])
  @@schema("public")
}

model MaterialConsumptionLog {
  id                String          @id @default(uuid())
  productionOrderId String
  rawMaterialId     String
  quantityConsumed  Decimal         @db.Decimal(10, 4)
  consumedAt        DateTime        @default(now())
  stageId           String?
  notes             String?
  ProductionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  RawMaterial       RawMaterial     @relation(fields: [rawMaterialId], references: [id])
  Stage             Stage?          @relation(fields: [stageId], references: [id])

  @@schema("public")
}

model MaterialReceipt {
  id          String      @id @default(uuid())
  materialId  String
  kgReceived  Decimal     @db.Decimal(10, 4)
  reference   String?
  supplierId  String?
  branchId    String?
  loggedBy    String?
  createdAt   DateTime    @default(now())
  Branch      Branch?     @relation(fields: [branchId], references: [id])
  RawMaterial RawMaterial @relation(fields: [materialId], references: [id])
  Supplier    Supplier?   @relation(fields: [supplierId], references: [id])

  @@schema("public")
}

model NotificationSettings {
  id              String   @id @default(uuid())
  userId          String   @unique
  emailEnabled    Boolean  @default(true)
  whatsappEnabled Boolean  @default(false)
  whatsappNumber  String?
  orderApproved   Boolean  @default(true)
  highScrapAlert  Boolean  @default(true)
  stockoutAlert   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  User            User     @relation(fields: [userId], references: [id])

  @@schema("public")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Branch    Branch[]
  User      User[]

  @@schema("public")
}

model Product {
  id             String           @id @default(uuid())
  name           String
  sku            String?          @unique
  category       ProductCategory  @default(manufactured_spring)
  origin         StockOrigin      @default(FACTORY_MADE)
  uom            String           @default("PCS")
  currentStock   Float            @default(0)
  unitCost       Float?
  landingCost    Float?
  vendor         String?
  branchId       String?
  reorderLevel   Int?
  stockStatus    StockStatus?     @default(AVAILABLE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  Branch         Branch?          @relation(fields: [branchId], references: [id])
  ProductAlias   ProductAlias[]
  ProductReceipt ProductReceipt[]
  StockMovement  StockMovement[]

  @@schema("public")
}

model ProductAlias {
  id         String   @id @default(uuid())
  product_id String
  alias      String
  created_at DateTime @default(now())
  Product    Product  @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, alias])
  @@index([alias])
  @@schema("public")
}

model ProductReceipt {
  id          String   @id @default(uuid())
  productId   String
  qtyReceived Float
  unitCost    Float?
  landingCost Float?
  reference   String?
  vendor      String?
  loggedBy    String?
  branchId    String?
  createdAt   DateTime @default(now())
  Branch      Branch?  @relation(fields: [branchId], references: [id])
  Product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model ProductionOrder {
  id                     String                   @id @default(uuid())
  orderNumber            String                   @unique
  designId               String
  quantity               Int                      @default(1)
  targetKg               Decimal                  @db.Decimal(10, 4)
  status                 ProductionStatus         @default(PENDING)
  priority               Priority                 @default(MEDIUM)
  currentStage           Int                      @default(1)
  currentDept            String?
  assignedTo             String?
  approvedBy             String?
  approvedAt             DateTime?
  completedAt            DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  MaterialConsumptionLog MaterialConsumptionLog[]
  design                 Design                   @relation(fields: [designId], references: [id])
  StageLog               StageLog[]

  @@schema("public")
}

model PurchaseOrder {
  id                String              @id @default(uuid())
  poNumber          String              @unique
  supplierId        String
  status            PurchaseStatus      @default(DRAFT)
  totalAmount       Decimal             @db.Decimal(10, 2)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  approvedBy        String?
  approvedAt        DateTime?
  expectedDelivery  DateTime?
  notes             String?
  Supplier          Supplier            @relation(fields: [supplierId], references: [id])
  PurchaseOrderItem PurchaseOrderItem[]

  @@schema("public")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  rawMaterialId   String
  quantity        Decimal       @db.Decimal(10, 4)
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  PurchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  RawMaterial     RawMaterial   @relation(fields: [rawMaterialId], references: [id])

  @@schema("public")
}

model RawMaterial {
  id                     String                   @id @default(uuid())
  sku                    String                   @unique
  materialName           String
  diameter               String
  supplierId             String?
  barcode                String?                  @unique
  batchNumber            String?
  availableKg            Decimal                  @default(0) @db.Decimal(10, 4)
  reservedKg             Decimal                  @default(0) @db.Decimal(10, 4)
  costPerKg              Float?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  BillOfMaterials        BillOfMaterials[]
  DemandForecast         DemandForecast[]
  InventoryRawMaterial   InventoryRawMaterial[]
  MaterialConsumptionLog MaterialConsumptionLog[]
  MaterialReceipt        MaterialReceipt[]
  PurchaseOrderItem      PurchaseOrderItem[]
  Supplier               Supplier?                @relation(fields: [supplierId], references: [id])

  @@schema("public")
}

model SaleItem {
  id              String        @id @default(uuid())
  saleOrderId     String
  finishedGoodsId String
  quantity        Int
  unitPrice       Decimal       @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  FinishedGoods   FinishedGoods @relation(fields: [finishedGoodsId], references: [id])
  SaleOrder       SaleOrder     @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model SaleOrder {
  id           String     @id @default(uuid())
  customerId   String?
  customerName String
  totalAmount  Decimal    @db.Decimal(10, 2)
  status       SaleStatus @default(PENDING)
  createdBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  SaleItem     SaleItem[]
  Customer     Customer?  @relation(fields: [customerId], references: [id])
  createdByUser User?     @relation(fields: [createdBy], references: [id])

  @@schema("public")
}

model Stage {
  id                     String                   @id @default(uuid())
  name                   String
  department             String
  sequence               Int
  designId               String
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  MaterialConsumptionLog MaterialConsumptionLog[]
  design                 Design                   @relation(fields: [designId], references: [id], onDelete: Cascade)
  StageLog               StageLog[]

  @@unique([designId, sequence])
  @@schema("public")
}

model StageLog {
  id              String          @id @default(uuid())
  orderId         String
  stageId         String?
  stageName       String
  sequence        Int
  kgIn            Decimal         @db.Decimal(10, 4)
  kgOut           Decimal         @db.Decimal(10, 4)
  kgScrap         Decimal         @db.Decimal(10, 4)
  scrapReason     String?
  department      String?
  operatorId      String
  notes           String?
  completedAt     DateTime        @default(now())
  User            User            @relation(fields: [operatorId], references: [id])
  ProductionOrder ProductionOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  Stage           Stage?          @relation(fields: [stageId], references: [id])

  @@schema("public")
}

model Supplier {
  id              String            @id @default(uuid())
  name            String
  code            String            @unique
  contactName     String?
  email           String?
  phone           String?
  address         String?
  taxId           String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  MaterialReceipt MaterialReceipt[]
  PurchaseOrder   PurchaseOrder[]
  RawMaterial     RawMaterial[]

  @@schema("public")
}

model UnitOfMeasure {
  id        String   @id @default(uuid())
  name      String
  symbol    String
  category  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@schema("public")
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  password             String?
  name                 String?
  role                 Role                  @default(PENDING)
  department           String?
  organizationId       String?
  branchId             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  AuditLog             AuditLog[]
  ImportBatch          ImportBatch[]
  NotificationSettings NotificationSettings?
  StageLog             StageLog[]
  Branch               Branch?               @relation(fields: [branchId], references: [id])
  Organization         Organization?         @relation(fields: [organizationId], references: [id])
  SaleOrderCreated     SaleOrder[]

  @@schema("public")
}

model StockMovement {
  id            String      @id @default(uuid())
  productId     String
  branchId      String?
  movementType  String
  quantity      Float
  reference     String?
  notes         String?
  createdAt     DateTime    @default(now())
  Product       Product     @relation(fields: [productId], references: [id])
  Branch        Branch?     @relation(fields: [branchId], references: [id])

  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum ImportMode {
  update
  ignore
  replace
  @@schema("public")
}

enum ImportStatus {
  uploaded
  mapping
  validating
  preview
  committing
  imported
  failed
  @@schema("public")
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
  @@schema("public")
}

enum ProductionStatus {
  PENDING
  APPROVED
  IN_PRODUCTION
  COMPLETED
  REJECTED
  CANCELLED
  @@schema("public")
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  ORDERED
  RECEIVED
  CANCELLED
  @@schema("public")
}

enum Role {
  PENDING
  ADMIN
  MANAGER
  OPERATOR
  WAREHOUSE
  SALES
  PACKAGING
  @@schema("public")
}

enum SaleStatus {
  PENDING
  CONFIRMED
  SHIPPED
  CANCELLED
  @@schema("public")
}

enum StockOrigin {
  FACTORY_MADE
  LOCAL_PURCHASE
  IMPORTED
  @@schema("public")
}

enum ProductCategory {
  manufactured_spring
  manufactured_ubolt
  imported
  local_purchase
  service
  @@schema("public")
}

enum ProductType {
  leaf_spring
  spring_assembly
  helper_spring
  auxiliary_spring
  u_bolt
  body_bolt
  centre_bolt
  bearing
  seal
  assembly
  bush
  hub
  brake_lining
  brake_pad
  brake_shoe
  clamp
  equalizer
  hardware
  repair
  retention
  rebonding
  riveting
  straightening
  other_service
  @@schema("public")
}

enum UOM {
  PCS
  KGS
  @@schema("public")
}

enum StockStatus {
  AVAILABLE
  LOW_STOCK
  OUT_OF_STOCK
  REORDER_NEEDED
  @@schema("public")
}

// ─────────────────────────────────────────────────────────────────────────────
// UNIFIED IMPORT TABLES (for new global parser)
// ─────────────────────────────────────────────────────────────────────────────

model ProductMaster {
  name            String
  location        String
  category        String
  opening_stock   Decimal @db.Decimal(12, 2) @default(0)
  current_stock   Decimal @db.Decimal(12, 2) @default(0)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@id([name, location])
  @@index([location])
  @@schema("public")
}

model SalesTransaction {
  id               String    @id @default(uuid())
  product_name     String
  quantity         Decimal   @db.Decimal(12, 2)
  transaction_date DateTime
  invoice_number   String?
  customer_name    String?
  location         String
  created_at       DateTime  @default(now())

  @@index([location])
  @@index([transaction_date])
  @@schema("public")
}

model StockReceipt {
  id               String    @id @default(uuid())
  product_name     String
  quantity         Decimal   @db.Decimal(12, 2)
  transaction_date DateTime
  reference_memo   String?
  location         String
  created_at       DateTime  @default(now())

  @@index([location])
  @@index([transaction_date])
  @@schema("public")
}
