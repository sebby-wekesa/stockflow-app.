# Production env example for Vercel.
# Add these in Vercel Project Settings > Environment Variables.

# Main connection string used by Prisma through the Supabase pooler.
DATABASE_URL=

# Supabase auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Optional alias used by some Supabase projects. Keep in sync with the anon key if used.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL used in invite/auth redirects.
NEXT_PUBLIC_APP_URL=https://stockflow-app-beta.vercel.app

# Initial super admin allow-list. Use comma-separated emails.
SUPER_ADMIN_EMAILS=

# Optional email delivery.
RESEND_API_KEY=
EMAIL_FROM=StockFlow <onboarding@resend.dev>

# Optional distributed rate limiting. If unset, the app uses in-memory fallback limits.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional CSP report-only mode. Set to 1 while testing policy changes.
CSP_REPORT_ONLY=

# Enable pgbouncer pooling for production.
ENABLE_PG_BOUNCER=true

# Connection limit to negotiate with your pooler. Tune to pool capacity.
DB_CONNECTION_LIMIT=10

# Pool timeout in seconds.
DB_POOL_TIMEOUT=30

# Per-statement timeout in milliseconds.
DB_STATEMENT_TIMEOUT=8000

# Retry attempts for transient DB errors.
DB_MAX_RETRY_ATTEMPTS=6

# Batch size for dashboard parallel queries to avoid bursting DB.
# Values below 1 or non-numeric values fall back to 3; values above 10 are clamped to 10.
DB_QUERY_BATCH_SIZE=3
