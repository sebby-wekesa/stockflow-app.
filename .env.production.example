# Production env example for database pooler and auth
# Copy this to .env.production (never commit secrets)

# Use DIRECT_URL for auth Prisma lookups (direct DB connection bypassing pooler)
# Example: DIRECT_URL=postgresql://user:password@db.internal:5432/postgres
DIRECT_URL=

# Main connection string (used by pooled Prisma client)
DATABASE_URL=

# Enable pgbouncer pooling for production (set to true in prod)
ENABLE_PG_BOUNCER=true

# Connection limit to negotiate with your pooler. Tune to pool capacity.
DB_CONNECTION_LIMIT=10

# Pool timeout (seconds)
DB_POOL_TIMEOUT=30

# Per-statement timeout (ms)
DB_STATEMENT_TIMEOUT=8000

# Retry attempts for transient DB errors
DB_MAX_RETRY_ATTEMPTS=6

# Batch size for dashboard parallel queries to avoid bursting DB
DB_QUERY_BATCH_SIZE=3
